# Copy this file to .env for local development.
# Do not commit .env or real credentials.

PROJECT_NAME=iot-drift-online-learning
ENVIRONMENT=development

# Preferred cloud model storage: Azure Blob Storage.
AZURE_STORAGE_CONNECTION_STRING=
AZURE_BLOB_CONTAINER_NAME=iot-drift-models

# Optional legacy AWS/S3 settings. Never commit real values.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=ap-southeast-1
AWS_S3_BUCKET_NAME=

# Local paths are relative to the project root.
DATA_RAW_DIR=data/raw
DATA_PROCESSED_DIR=data/processed
DATA_SYNTHETIC_DIR=data/synthetic
OUTPUT_DIR=outputs
MODEL_STORAGE_DIR=cloud_model_storage
